# Para testar localmente, APP_ENV=development. Para Render gratuito, APP_ENV=beta.
APP_ENV=development
AEVIA_PORT=8017
PUBLIC_URL=http://localhost:8017
ENABLE_PUBLIC_CONTRIBUTIONS=yes
# Na beta publica: ENABLE_PUBLIC_CONTRIBUTIONS=no
ENABLE_PUBLIC_NOMINATIM=yes
# Na beta publica: ENABLE_PUBLIC_NOMINATIM=no (busca de ruas por mapa)
# GEOAPIFY_API_KEY=opcional (para geocodificacao em hospedagem publica)
# ADMIN_PASSWORD=opcional, somente em uso local de moderacao
# SESSION_SECRET=opcional, configure antes de producao com administracao
# AEVIA_CONTACT_EMAIL=contato-responsavel@exemplo.com
# GEMINI_API_KEY=opcional, nao necessario para o beta
# DB_PATH=./storage/aevia.sqlite3
# STORAGE_DIR=./storage
